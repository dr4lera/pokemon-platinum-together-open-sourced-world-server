[Unit]
Description=Plat Together world backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=platinum
Group=platinum
WorkingDirectory=/srv/plat-together-world-server
ExecStart=/usr/bin/node /srv/plat-together-world-server/start.mjs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
